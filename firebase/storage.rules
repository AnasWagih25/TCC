rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{path=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Payment screenshots are confidential. Only server routes may upload/read them.
    match /payment-receipts/{path=**} {
      allow read, write: if false;
    }
    // Merge INSIDE the existing match /b/{bucket}/o. Keep existing product rules.
match /review-photos/{reviewId}/{fileName} {
  allow read: if true;
  allow create: if reviewId.matches('[a-f0-9-]{36}')
    && fileName.matches('[a-f0-9-]{36}[.]jpg')
    && request.resource.size < 8 * 1024 * 1024
    && request.resource.contentType == 'image/jpeg';
  allow update: if false;
  allow delete: if request.auth != null && request.auth.token.admin == true;
}

  }
}
